# ~/public_html/.htaccess
Options -MultiViews
RewriteEngine On
# force www (ou l’inverse si tu préfères apex)
RewriteCond %{HTTP_HOST} ^cdotchad\.com$ [NC]
RewriteRule ^(.*)$ https://www.cdotchad.com/$1 [L,R=301]

# --- Assets & API: ne jamais réécrire vers la SPA ---
# (NOTE: [END] > [L] : on arrête TOUTE réécriture, pas seulement la règle courante)
RewriteRule ^backend(?:/.*)?$ - [END]
RewriteRule ^api/uploads(?:/.*)?$ - [END]
RewriteRule ^assets(?:/.*)?$ - [END]
RewriteRule \.(?:js|css|map|png|jpe?g|gif|svg|ico|webp|pdf|woff2?)$ - [END]

# --- Si fichier/dossier existe, le servir tel quel ---
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]

# --- SPA fallback pour tout le reste ---
RewriteRule . /index.html [END]

# Cache HTML = off, assets = long cache
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header set Surrogate-Control "no-store"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# (Optionnel) Expires pour images
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
