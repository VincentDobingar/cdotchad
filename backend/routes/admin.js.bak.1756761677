// 📁 routes/admin.js
import express from "express";
import { rateLimit, ipKeyGenerator } from "express-rate-limit";
import { pool } from "../config/db.js";

// 🔐 Middlewares
import { verifyAdminToken } from "../middlewares/verifyAdminToken.js";
import { verifySuperAdmin } from "../middlewares/verifySuperAdmin.js";

// 📥 Contrôleurs principaux
import {
  loginAdmin,
  ajouterAdministrateur,
  getAllAdmins,
  deleteAdmin,
  getAdminMe,
  forgotPassword,
  resetPassword,
  changePassword,
  refreshSession,
} from "../controllers/admin.controller.js";

const router = express.Router();

/* ---------------------------
   🛡️ Rate limit SEULEMENT sur /login
---------------------------- */
const adminLimiter = rateLimit({
  windowMs: 15 * 60 * 1000,      // 15 min
  limit: 100,                    // 100 req / fenêtre
  standardHeaders: 'draft-7',    // X-RateLimit-* modernes
  legacyHeaders: false,          // désactive X-RateLimit-*
  keyGenerator: ipKeyGenerator,  // ✅ corrige l’erreur IPv6
  skipFailedRequests: false,
  message: { error: "RATE_LIMITED" },
});

router.use(adminLimiter);

// ---------------------------
// 🔐 Authentification
// ---------------------------

// ⬇️ Limiter uniquement /login
router.post("/login", loginLimiter, loginAdmin);

// ✅ Recommandé en POST (évite cache GET + fuites via URL)
router.post("/refresh", refreshSession);

// Infos admin connecté
router.get("/me", verifyAdminToken, getAdminMe);
router.get("/profile", verifyAdminToken, getAdminMe);

// Changer mot de passe (admin connecté)
router.put("/change-password", verifyAdminToken, changePassword);

// Mot de passe oublié / reset (publique)
router.post("/forgot-password", forgotPassword);
router.post("/reset-password/:token", resetPassword);

// ---------------------------
// 👥 Gestion des administrateurs
// ---------------------------
router.get("/admins", verifyAdminToken, getAllAdmins);

router.post("/admins", verifyAdminToken, verifySuperAdmin, ajouterAdministrateur);

// Validation légère de l'ID (numérique)
router.delete("/admins/:id", verifyAdminToken, verifySuperAdmin, async (req, res, next) => {
  const id = Number(req.params.id);
  if (!Number.isInteger(id) || id <= 0) {
    return res.status(400).json({ error: "INVALID_ID", details: "Paramètre :id invalide" });
  }
  try {
    // délégué au contrôleur existant si vous voulez, sinon fait localement
    await deleteAdmin(req, res);
  } catch (err) {
    next(err);
  }
});

// ---------------------------
// 🧨 Réinitialisation base (ultra-protégée)
// ---------------------------
router.delete("/reset", verifyAdminToken, verifySuperAdmin, async (_req, res) => {
  // Double garde-fou pour la prod : nécessite ALLOW_DB_RESET=true
  const isProd = process.env.NODE_ENV === "production";
  if (isProd && process.env.ALLOW_DB_RESET !== "true") {
    return res.status(403).json({ error: "RESET_FORBIDDEN", message: "Réinitialisation désactivée en production." });
  }

  try {
    await pool.query("BEGIN");
    // ⚠️ TRUNCATE avec CASCADE et réinitialisation des ID
    await pool.query("TRUNCATE TABLE candidatures, offres RESTART IDENTITY CASCADE");
    await pool.query("COMMIT");
    res.json({ message: "✅ Base de données réinitialisée." });
  } catch (err) {
    await pool.query("ROLLBACK");
    console.error("❌ Erreur réinitialisation :", err.message);
    res.status(500).json({ error: "RESET_FAILED" });
  }
});

// ---------------------------
// ✅ Vérification du token
// ---------------------------
router.get("/verify-token", verifyAdminToken, (req, res) => {
  res.json({ message: "Token valide ✅", admin: req.admin });
});

export default router;
