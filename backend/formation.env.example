# Plateforme de formation — variables à ajouter au .env du backend
# (les autres variables du .env existant restent inchangées)

# URL publique du site (liens dans les e-mails, QR code des certificats)
PUBLIC_BASE_URL=https://www.cdotchad.com
# URL de l'API vue depuis le serveur BigBlueButton (rappels de fin de séance, replays, présences)
FORMATION_API_URL=https://www.cdotchad.com/backend
# Secret des liens temporaires et des rappels (sinon JWT_SECRET est utilisé)
FORMATION_SECRET=une-longue-chaine-aleatoire

# --- Option VPS : BigBlueButton sur notre serveur ---------------------------
# Donnés par « bbb-conf --secret » sur le serveur vidéo. Laisser vide pour
# l'option cPanel : les séances se font alors avec un lien Zoom/Jitsi.
BBB_URL=https://visio.cdotchad.com/bigbluebutton/api
BBB_SECRET=
BBB_CHECKSUM_ALGO=sha256
FORMATION_OUVERTURE_AVANT_MIN=30

# --- Stockage privé des replays, supports, devoirs et certificats ----------
# local : backend/uploads_prives/formations (compatible cPanel, espace limité)
# s3    : Backblaze B2 ou OVHcloud Object Storage (bucket PRIVÉ)
FORMATION_STOCKAGE=local
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
S3_REGION=eu-central-003
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
FORMATION_LIEN_MINUTES=120
FORMATION_REPLAY_MAX_MO=2048
FORMATION_SUPPORT_MAX_MO=50
FORMATION_DEVOIR_MAX_MO=20

# --- Certificat ------------------------------------------------------------
CERTIF_SIGNATAIRE=La Direction générale
CERTIF_FONCTION=CDO Consulting Tchad
# Images hors dépôt (PNG à fond transparent), chemin absolu ou relatif à backend/
CERTIF_SIGNATURE_IMG=
CERTIF_CACHET_IMG=
CERTIF_PREFIXE=CDO
